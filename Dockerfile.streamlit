FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --default-timeout=1000 --no-cache-dir -r requirements.txt

COPY . .

# No `dvc pull` needed here, unlike the API's Dockerfile: this frontend only
# talks to the API over HTTP (app/streamlit_app.py never calls joblib.load
# or reads a DVC-tracked path directly) — it has nothing of its own that
# config.yaml/dvc.lock track. Deploy the API image with its dvc pull step
# applied, and point this container's API_URL env var at it.

EXPOSE 8501

# Start ONLY the Streamlit frontend
CMD ["streamlit", "run", "app/streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0"]